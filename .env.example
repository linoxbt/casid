# Casid environment

# Network
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114
# Mainnet: https://flare-api.flare.network/ext/C/rpc chainId 14

# Contracts (set after deploy)
TOPIC_REGISTRY_ADDRESS=
SUBSCRIPTION_HUB_ADDRESS=
TRIGGER_EXECUTOR_ADDRESS=
FDC_VERIFICATION_ADDRESS=
FTSO_V2_ADDRESS=

# FDC / DA Layer
# Live prepare/submit/DA-proof flow lives in services/fdcLive.ts (no mock/live
# switch — it always calls real Flare testnet endpoints). On-chain proof
# consumption is gated by the deployed ProofVerifier's own mockMode flag
# (owner-toggleable on-chain). See contracts/script/RedeployFixed.s.sol for
# the current ProofVerifier/TriggerExecutor pair (typed IPayment.Proof
# on-chain verification) and contracts/script/SetLive.s.sol for the earlier
# mockMode-flip-only step it superseded.
FDC_HUB_ADDRESS=
DA_LAYER_URL=https://ctn2-data-availability.flare.network/
PROOF_VERIFIER_ADDRESS=
# Flare's testnet FDC verifier base URL + API key (public demo key by default)
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FDC_API_KEY=00000000-0000-0000-0000-000000000000

# Coordinator
COORDINATOR_PORT=4100
COORDINATOR_URL=http://localhost:4100
WEBHOOK_SIGNING_SECRET=dev-change-me-casid-hmac
DATABASE_PATH=./data/casid.db
NODE_ENV=development
# Required when NODE_ENV=production (gates non-GET /v1/* routes)
CASID_API_KEY=
# Comma-separated allow-list for CORS; unset + non-production allows any origin
CORS_ORIGINS=
# Webhook delivery tuning
WEBHOOK_CONCURRENCY=5
WEBHOOK_MAX_ATTEMPTS=3
# Passive XRPL payment watcher — polls each active topic://payment/xrp/{dest}
# destination for new incoming payments and attests them automatically
# instead of requiring a manually pasted tx id. Only runs when FLARE_CHAIN_ID
# is a real Flare network (see services/flare.ts's isFlareNetwork).
XRPL_WATCHER_ENABLED=true
XRPL_WATCHER_INTERVAL_MS=20000
# Override the auto-selected XRPL JSON-RPC endpoint (testnet vs mainnet,
# based on FLARE_CHAIN_ID)
XRPL_RPC_URL=
# Basic in-memory rate limit applied to /v1/attest/* and /v1/fdc/*
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Native token value (in ETH-denominated units, e.g. "0.01") sent with
# on-chain SubscriptionHub.subscribe() credit deposits, if any
SUBSCRIPTION_CREDIT_ETH=
# Override auto-detected FTSO feed id, e.g. FTSO_FEED_XRP_USD=0x015852502f55534400000000000000000000000000
# FTSO_FEED_<SYMBOL>=

# Contracts verification (forge verify-contract on Coston2 Blockscout)
FLARESCAN_API_KEY=
# Foundry-only: opt into deploying MockFdcVerification/MockFtsoV2 (Deploy.s.sol)
CASID_USE_MOCKS=

# Web
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:4100
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_TOPIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SUBSCRIPTION_HUB_ADDRESS=
NEXT_PUBLIC_TRIGGER_EXECUTOR_ADDRESS=
# Sent as `Authorization: Bearer <key>` from the web console to the coordinator;
# must match CASID_API_KEY
NEXT_PUBLIC_CASID_API_KEY=

# Optional: private key for demo attestation txs (never commit real keys)
DEPLOYER_PRIVATE_KEY=
